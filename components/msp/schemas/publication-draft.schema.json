{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "msp://schemas/publication-draft.schema.json",
  "title": "MSP Skill Publication Draft",
  "description": "Producer-neutral draft envelope used by publisher adapters before producing canonical MSP registry artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "draft_version", "publisher", "skills"],
  "properties": {
    "kind": { "const": "MspSkillPublicationDraft" },
    "draft_version": { "$ref": "#/$defs/semver" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "source"],
      "properties": {
        "issuer": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source": { "type": "string", "minLength": 1, "maxLength": 300 },
        "unsigned": { "type": "boolean", "default": true }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "category", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^pack(\\.[a-z0-9][a-z0-9_-]*)+\\.v[0-9]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "$ref": "#/$defs/semver" },
        "category": { "$ref": "#/$defs/category" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "category", "summary", "body"],
        "properties": {
          "id": { "type": "string", "pattern": "^skill(\\.[a-z0-9][a-z0-9_-]*)+\\.v[0-9]+$" },
          "source_id": { "type": "string", "maxLength": 512 },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "version": { "$ref": "#/$defs/semver" },
          "category": { "$ref": "#/$defs/category" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "body": { "type": "string", "minLength": 1 },
          "task_patterns": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "default": [] },
          "required_checks": { "type": "array", "items": { "$ref": "#/$defs/token" }, "default": [] },
          "source_documents": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2048 }, "default": [] }
        }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "token": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$" },
    "category": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$" }
  }
}
